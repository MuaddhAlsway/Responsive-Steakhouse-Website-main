# Application
APP_ENV=local

# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=steakhouse
DB_USER=root
DB_PASSWORD=

# Owner-only API endpoints (reservations list).
# Leave empty to disable the token check (dev only). ALWAYS set in production.
#ADMIN_API_TOKEN=change-me

# Rate limiting for public write endpoints (can be tuned per deployment).
# Disable by leaving values empty.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60