# ============================================================
# Steakhouse - Environment template (COPY to .env, never commit)
# ============================================================

# Application
# local  -> errors visible, no TLS required
# production -> errors hidden, TLS enabled by default
APP_ENV=local

# ----- MySQL / MariaDB connection -----
# Local XAMPP defaults shown below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=steakhouse
DB_USER=root
DB_PASSWORD=

# ----- TLS (only needed for production / Aiven MySQL, SSL REQUIRED) -----
# Leave everything below commented/empty for local development.
# The Docker entrypoint and src/Database.php read these at runtime.
#DB_SSL=true
#DB_SSL_CA=/etc/ssl/certs/aiven-ca.pem
#DB_SSL_VERIFY_SERVER_CERT=true
#AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----

# Owner-only API endpoints (reservations list).
# Leave empty to disable the token check (dev only). ALWAYS set in production.
#ADMIN_API_TOKEN=change-me

# Rate limiting for public write endpoints (can be tuned per deployment).
# Disable by leaving values empty.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60